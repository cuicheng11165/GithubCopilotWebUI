NODE_ENV=development
LOG_LEVEL=info
LOG_DIR=./data/logs
LOG_ROTATE_MAX_BYTES=52428800
LOG_ROTATE_MAX_FILES=10
LOG_ROTATE_COMPRESS=true
PUBLIC_APP_URL=http://localhost:3000
WEB_PORT=3000
API_HOST=127.0.0.1
API_PORT=4000
SANDBOX_RUNNER_HOST=127.0.0.1
SANDBOX_RUNNER_PORT=4100
WORKER_CONTROL_HOST=127.0.0.1
WORKER_CONTROL_PORT=4200
# Relative SQLite paths resolve from packages/db/prisma-sqlite.
DATABASE_URL=file:../../../data/copilot.db?connection_limit=1
# Startup rejects values that begin with "replace-with-".
# node -e "console.log(require('node:crypto').randomBytes(48).toString('base64'))"
COOKIE_SECRET=replace-with-at-least-32-random-characters
# Must be base64 that decodes to exactly 32 bytes.
# node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
TOKEN_ENCRYPTION_KEY=replace-with-base64-encoded-32-byte-key
# Copy config/repositories.example.yaml to this path before startup.
REPOSITORIES_CONFIG=./config/repositories.yaml
COPILOT_HOME=./data/copilot
SANDBOX_RUNNER_URL=http://127.0.0.1:4100
# Generate a distinct value. Placeholders that begin with "replace-with-" are rejected.
SANDBOX_RUNNER_TOKEN=replace-with-a-long-random-service-token
WORKER_CONTROL_URL=http://127.0.0.1:4200
WORKER_CONTROL_TOKEN=replace-with-a-different-long-random-service-token
WORKER_POLL_INTERVAL_MS=200
EVENT_POLL_INTERVAL_MS=200
# API and worker are separate processes. The worker wakes the API event hub;
# each API process still polls SQLite as a fallback and fans events out in memory.
API_INTERNAL_URL=http://127.0.0.1:4000
# Commands and private scripts run directly as the current host user.
# The worker aborts sandbox HTTP calls after COMMAND_TIMEOUT_SECONDS plus the buffer below.
LOCAL_SANDBOX_TMP_ROOT=./data/local-sandbox
WORKER_CONCURRENCY=2
APPROVAL_TIMEOUT_SECONDS=300
# A turn that runs longer than this is marked timed-out instead of failed. Default is 15 minutes.
TURN_TIMEOUT_MS=900000
# Running turns are owned by one worker until this lease expires. Expired leases are
# marked interrupted and are not started again automatically. Default is 30 seconds.
TURN_LEASE_MS=30000
# LLM tracing is disabled by default. Content capture may include source code and prompts.
LLM_TRACE_ENABLED=false
LLM_TRACE_CAPTURE_CONTENT=false
LLM_TRACE_FILE=./data/logs/otel/copilot.jsonl
COMMAND_TIMEOUT_SECONDS=120
SANDBOX_REQUEST_TIMEOUT_BUFFER_SECONDS=15
COMMAND_MAX_OUTPUT_BYTES=1048576
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_ALLOWED_ORGS=your-org
GITHUB_ALLOWED_ENTERPRISES=
GHE_HOST=
GHE_CLIENT_ID=
GHE_CLIENT_SECRET=
GHE_ALLOWED_ORGS=
GHE_ALLOWED_ENTERPRISES=
